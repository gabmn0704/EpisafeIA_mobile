{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.36:4000/api/v1",
        "EXPO_PUBLIC_ALLOW_CLEARTEXT": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://episafe-api.onrender.com/api/v1",
        "EXPO_PUBLIC_ALLOW_CLEARTEXT": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
